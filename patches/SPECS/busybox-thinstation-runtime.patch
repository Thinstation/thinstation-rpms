--- a/busybox.spec
+++ b/busybox.spec
@@ -1,3 +1,6 @@
+# Dist is expanded immediately: custom payloads are newer than the same Fedora build.
+%global dist %{?dist}.thinstation1
+
 # Groupings
 %global build_petitboot 1
 
@@ -65,6 +68,9 @@
 Source4:	busybox-glibc-static.config
 Source5:	busybox-uclibc-static.config
 Source6:	busybox-musl-static.config
+Source7:	busybox-default6.script
+Source8:	busybox-default6-tests.py
+BuildRequires:	python3
 # musl kernel headers
 Source10:	https://github.com/sabotage-linux/kernel-headers/archive/refs/tags/v4.19.88-1.tar.gz
 Patch0:		busybox-1.31.1-stime-fix.patch
@@ -314,7 +320,22 @@
 cp busybox_unstripped busybox.shared
 cp docs/busybox.1 docs/busybox.shared.1
 
+%check
+# Validate the actual executable after oldconfig, not only the input patch.
+./busybox.shared bbconfig > thinstation-shared.config
+for option in UDHCPC UDHCPC6 FEATURE_IPV6 FEATURE_UDHCPC6_RFC3646 FEATURE_UDHCPC6_RFC4704 FEATURE_UDHCPC6_RFC4833 FEATURE_UDHCPC6_RFC5970 DF FEATURE_DF_FANCY; do
+    grep -qx "CONFIG_${option}=y" thinstation-shared.config || exit 1
+done
+grep -qx '# CONFIG_FEATURE_SKIP_ROOTFS is not set' thinstation-shared.config || exit 1
+grep -qx 'CONFIG_UDHCPC_DEFAULT_INTERFACE="eth0"' thinstation-shared.config || exit 1
+grep -qx 'CONFIG_UDHCPC6_DEFAULT_SCRIPT="/usr/share/udhcpc/default6.script"' thinstation-shared.config || exit 1
+./busybox.shared --list | grep -qx udhcpc6 || exit 1
+./busybox.shared df -h / || exit 1
+./busybox.shared ash -n %{SOURCE7} || exit 1
+python3 %{SOURCE8} %{SOURCE7} || exit 1
+
 %install
+install -D -m 755 %{SOURCE7} %{buildroot}%{_datadir}/udhcpc/default6.script
 mkdir -p %{buildroot}%{_sbindir}
 install -m 755 busybox.*.static %{buildroot}%{_sbindir}
 mv %{buildroot}%{_sbindir}/busybox.%{default_type}.static %{buildroot}%{_sbindir}/busybox
@@ -354,6 +375,7 @@
 %endif
 
 %files shared
+%{_datadir}/udhcpc/default6.script
 %doc LICENSE README
 %{_sbindir}/busybox.shared
 %{_mandir}/man1/busybox.shared.1.gz
